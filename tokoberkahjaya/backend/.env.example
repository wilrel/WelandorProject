# Database. Kosongkan untuk memakai SQLite lokal (tokoberkahjaya.db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokoberkahjaya

# JWT. WAJIB diganti di production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000

# Batas ukuran file import (MB)
MAX_UPLOAD_MB=10
